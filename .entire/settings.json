{
  "enabled": true,
  "strategy_options": {
    "push_sessions": true
  },
  "redaction": {
    "pii": {
      "enabled": true,
      "email": true,
      "phone": true,
      "address": false
    },
    "custom_redactions": {
      "NOOL_HUB_TOKEN": "NOOL_HUB_TOKEN=[A-Za-z0-9._-]{16,}",
      "NOOL_IDENTITY_KEY": "NOOL_IDENTITY_KEY=[0-9a-fA-F]{64}"
    },
    "betterleaks": {
      "enabled": true
    }
  },
  "commit_linking": "always",
  "checkpoints": {
    "primary": {
      "type": "git-refs"
    }
  }
}
